<%
    const viewDateLocale = typeof dateLocale !== 'undefined' ? dateLocale : undefined;
    const jsonForScript = (value) => JSON.stringify(value)
        .replace(/</g, '\\u003c')
        .replace(/>/g, '\\u003e')
        .replace(/&/g, '\\u0026')
        .replace(/\u2028/g, '\\u2028')
        .replace(/\u2029/g, '\\u2029');
    const accessLogNodeNames = (typeof accessLogNodes === 'undefined' ? [] : accessLogNodes)
        .reduce((names, node) => {
            if (node?._id) names[String(node._id)] = node.name || String(node._id);
            return names;
        }, {});
%>
<div class="page-header">
    <a href="/panel/users" class="btn btn-back"><i class="ti ti-chevron-left"></i> <%= t('common.backToList') %></a>
</div>

<div class="row">
    <div class="col-8">
        <div class="card">
            <div class="card-header">
                <h2><%= t('users.user') %> <%= user.userId %></h2>
                <% const isExpired = user.expireAt && new Date(user.expireAt).getTime() < Date.now(); %>
                <span class="badge badge-<%= isExpired ? 'danger' : (user.enabled ? 'success' : 'secondary') %> badge-lg">
                    <%= isExpired ? t('common.expired') : (user.enabled ? t('common.active') : t('common.inactive')) %>
                </span>
            </div>
            <div class="card-body">
                <div class="detail-grid">
                    <div class="detail-item">
                        <label><%= t('users.userId').replace(/\s*\*$/, '') %></label>
                        <code class="value"><%= user.userId %></code>
                    </div>
                    <div class="detail-item">
                        <label><%= t('users.username') %></label>
                        <span class="value"><%= user.username || '—' %></span>
                    </div>
                    <div class="detail-item">
                        <label><%= t('users.hysteriaPassword') %></label>
                        <code class="value"><%= user.password %></code>
                    </div>
                </div>
                
                <h3 class="section-title"><%= t('users.groups') %></h3>
                <div class="groups-list">
                    <% if (user.groups && user.groups.length > 0) { %>
                        <% user.groups.forEach(group => { %>
                            <span class="group-tag" style="background: <%= group.color %>20; border-color: <%= group.color %>; color: <%= group.color %>">
                                <%= group.name %>
                            </span>
                        <% }); %>
                    <% } else { %>
                        <span class="text-muted"><%= t('users.noGroupsAccess') %></span>
                    <% } %>
                </div>
                
                <h3 class="section-title"><%= t('users.limits') %></h3>
                <div class="detail-grid">
                    <div class="detail-item">
                        <label><%= t('users.traffic') %></label>
                        <% const usedBytes = (user.traffic?.tx || 0) + (user.traffic?.rx || 0); %>
                        <% const limitBytes = user.trafficLimit || 0; %>
                        <span class="value"><%= formatTraffic(usedBytes, { decimals: 2 }) %> / <%= limitBytes > 0 ? formatTraffic(limitBytes, { decimals: 0 }) : '∞' %></span>
                    </div>
                    <div class="detail-item">
                        <label><%= t('users.devices') %></label>
                        <% 
                            let deviceLimit = user.maxDevices;
                            let deviceLimitStr = '∞';
                            if (deviceLimit === 0) {
                                const groupLimits = (user.groups || []).filter(g => g.maxDevices > 0).map(g => g.maxDevices);
                                if (groupLimits.length > 0) {
                                    deviceLimit = Math.min(...groupLimits);
                                    deviceLimitStr = deviceLimit + ' ' + t('users.deviceFromGroup');
                                }
                            } else if (deviceLimit > 0) {
                                deviceLimitStr = deviceLimit.toString();
                            }
                        %>
                        <span class="value"><%= deviceLimitStr %></span>
                    </div>
                    <div class="detail-item">
                        <label><%= t('users.txRx') %></label>
                        <span class="value">
                            <i class="ti ti-arrow-up" style="color:var(--success)"></i> <%= formatTraffic(user.traffic?.tx || 0, { decimals: 2 }) %> / 
                            <i class="ti ti-arrow-down" style="color:var(--info)"></i> <%= formatTraffic(user.traffic?.rx || 0, { decimals: 2 }) %>
                        </span>
                    </div>
                    <div class="detail-item">
                        <label><%= t('users.createdAt') %></label>
                        <span class="value"><%= user.createdAt ? new Date(user.createdAt).toLocaleString(viewDateLocale, { dateStyle: 'medium', timeStyle: 'short' }) : '—' %></span>
                    </div>
                    <div class="detail-item">
                        <label><%= t('users.expires') %></label>
                        <span class="value"><%= user.expireAt ? new Date(user.expireAt).toLocaleString(viewDateLocale, { dateStyle: 'medium', timeStyle: 'short' }) : t('users.forever') %></span>
                    </div>
                </div>
                
                <% if (typeof hwidEnabled !== 'undefined' && hwidEnabled) { %>
                <h3 class="section-title"><%= t('users.hwidDevices') %></h3>
                <% 
                    let hwidLimitDisp = '—';
                    if (typeof hwidLimit !== 'undefined') {
                        if (hwidLimit < 0) hwidLimitDisp = '∞';
                        else if (hwidLimit > 0) hwidLimitDisp = String(hwidLimit);
                        else {
                            const gl = (user.groups || []).filter(g => g.maxDevices > 0).map(g => g.maxDevices);
                            hwidLimitDisp = gl.length ? String(Math.min(...gl)) : '—';
                        }
                    }
                    const hwidCnt = typeof hwidCount !== 'undefined' ? hwidCount : 0;
                %>
                <p class="hint" style="margin-top:0"><%= t('users.hwidDevicesSummary') %> <strong><%= hwidCnt %> / <%= hwidLimitDisp %></strong></p>
                <% if (hwidDevices && hwidDevices.length > 0) { %>
                <div style="overflow-x:auto;">
                    <table class="table table-sm" id="hwidDeviceTable">
                        <thead>
                            <tr>
                                <th><%= t('users.hwidModel') %></th>
                                <th>OS</th>
                                <th><%= t('users.hwidLastSeen') %></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% hwidDevices.forEach(function(d) { %>
                            <tr data-hwid="<%- encodeURIComponent(d.hwid) %>">
                                <td><code style="font-size:11px"><%= d.deviceModel || '—' %></code></td>
                                <td><small><%= [d.platform, d.osVersion].filter(Boolean).join(' ') || '—' %></small></td>
                                <td><small><%= d.lastSeenAt ? new Date(d.lastSeenAt).toLocaleString(viewDateLocale, { dateStyle: 'short', timeStyle: 'short' }) : '—' %></small></td>
                                <td><button type="button" class="btn btn-sm btn-danger" onclick="unlinkHwid(this.closest('tr').dataset.hwid)"><%= t('users.unlinkDevice') %></button></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                <p class="text-muted"><%= t('users.noHwidDevices') %></p>
                <% } %>
                <% if (hwidCnt > 0) { %>
                <button type="button" class="btn btn-sm btn-secondary mt-1" onclick="unlinkAllHwid()"><%= t('users.unlinkAllHwidDevices') %></button>
                <% } %>
                <% } %>
                
                <h3 class="section-title"><%= t('users.availableNodes') %> (<%= effectiveNodes?.length || 0 %>)</h3>
                <div class="nodes-list">
                    <% if (effectiveNodes && effectiveNodes.length > 0) { %>
                        <% effectiveNodes.forEach(node => { %>
                        <div class="node-badge">
                            <span class="node-name"><%= node.name %></span>
                            <span class="node-ip"><%= node.type === 'virtual' ? 'virtual / balancer' : (node.ip || '—') %></span>
                        </div>
                        <% }); %>
                    <% } else { %>
                        <span class="text-muted"><%= t('users.noNodes') %></span>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-4">
        <div class="card">
            <div class="card-header">
                <h2><%= t('common.actions') %></h2>
            </div>
            <div class="card-body">
                <div class="actions-list">
                    <% if (!isExpired) { %>
                        <% if (user.enabled) { %>
                        <button class="btn btn-warning btn-block" onclick="toggleUser(false)">
                            <%= t('users.disableUser') %>
                        </button>
                        <% } else { %>
                        <button class="btn btn-success btn-block" onclick="toggleUser(true)">
                            <%= t('users.enableUser') %>
                        </button>
                        <% } %>
                    <% } %>
                    
                    <a href="/panel/users/<%= user.userId %>/edit" class="btn btn-primary btn-block">
                        <%= t('users.editUser') %>
                    </a>
                    
                    <button class="btn btn-block" onclick="copySubscription()">
                        <i class="ti ti-clipboard"></i> <%= t('users.copySubscription') %>
                    </button>
                    
                    <a href="<%= baseUrl %>/api/files/<%= user.subscriptionToken %>" 
                       target="_blank" class="btn btn-block">
                        <i class="ti ti-external-link"></i> <%= t('users.openSubscription') %>
                    </a>
                    
                    <button class="btn btn-block" onclick="resetTraffic()">
                        <i class="ti ti-refresh"></i> <%= t('users.resetTraffic') %>
                    </button>
                    
                    <hr>
                    
                    <button class="btn btn-danger btn-block" onclick="deleteUser()">
                        <%= t('users.deleteUser') %>
                    </button>
                </div>
            </div>
        </div>
        
        <div class="card mt-2">
            <div class="card-header">
                <h2><%= t('users.subscriptionLink') %></h2>
            </div>
            <div class="card-body">
                <div id="qrcode" style="text-align:center;margin-bottom:12px;"></div>
                <p class="hint mb-1"><%= t('users.universalLink') %></p>
                <input type="text" readonly class="input-readonly" 
                       value="<%= baseUrl %>/api/files/<%= user.subscriptionToken %>" id="subLink">
                <button class="btn btn-sm btn-block mt-1" onclick="copySubscription()"><%= t('common.copy') %></button>
            </div>
        </div>
    </div>
</div>

<section class="card user-insights" id="userInsights" aria-labelledby="userInsightsTitle">
    <div class="user-insights-header">
        <div class="user-insights-heading">
            <span class="user-insights-icon" aria-hidden="true"><i class="ti ti-chart-histogram"></i></span>
            <div>
                <h2 id="userInsightsTitle"><%= t('userInsights.title') %></h2>
                <p><%= t('userInsights.description') %></p>
            </div>
        </div>
        <div class="user-insights-tabs" role="tablist" aria-label="<%= t('userInsights.tablistLabel') %>">
            <button type="button" class="user-insights-tab active" id="userTrafficTab"
                    role="tab" aria-selected="true" aria-controls="userTrafficPanel" tabindex="0">
                <i class="ti ti-chart-area-line" aria-hidden="true"></i>
                <span><%= t('userInsights.trafficTab') %></span>
            </button>
            <button type="button" class="user-insights-tab" id="userAccessTab"
                    role="tab" aria-selected="false" aria-controls="userAccessPanel" tabindex="-1">
                <i class="ti ti-list-search" aria-hidden="true"></i>
                <span><%= t('userInsights.accessTab') %></span>
            </button>
        </div>
    </div>

    <p class="ui-visually-hidden" id="userInsightsStatus" role="status" aria-live="polite"></p>

    <div class="user-insights-panel" id="userTrafficPanel" role="tabpanel"
         aria-labelledby="userTrafficTab" aria-busy="true">
        <div class="user-insights-toolbar">
            <div class="user-insights-context">
                <h3><%= t('userInsights.trendTitle') %></h3>
                <p id="trafficPeriod"><%= t('userInsights.loadingTraffic') %></p>
            </div>
            <div class="traffic-range" role="group" aria-label="<%= t('userInsights.rangeLabel') %>">
                <button type="button" class="traffic-range-btn" data-range="24h" aria-pressed="false">24h</button>
                <button type="button" class="traffic-range-btn active" data-range="7d" aria-pressed="true">7d</button>
                <button type="button" class="traffic-range-btn" data-range="30d" aria-pressed="false">30d</button>
            </div>
        </div>

        <div class="user-insights-skeleton" id="trafficSkeleton" aria-hidden="true">
            <div class="insights-metrics insights-metrics-skeleton">
                <span class="ui-skeleton"></span><span class="ui-skeleton"></span><span class="ui-skeleton"></span>
            </div>
            <div class="insights-skeleton-grid">
                <span class="ui-skeleton ui-skeleton-chart"></span>
                <span class="ui-skeleton ui-skeleton-list"></span>
            </div>
        </div>

        <div class="insights-state insights-state-error" id="trafficError" hidden>
            <span class="insights-state-icon" aria-hidden="true"><i class="ti ti-cloud-off"></i></span>
            <div>
                <h3><%= t('userInsights.trafficErrorTitle') %></h3>
                <p><%= t('userInsights.trafficErrorDescription') %></p>
                <button type="button" class="btn btn-sm" id="trafficRetry">
                    <i class="ti ti-refresh" aria-hidden="true"></i> <%= t('userInsights.retry') %>
                </button>
            </div>
        </div>

        <div id="trafficContent" hidden>
            <dl class="insights-metrics" aria-label="<%= t('userInsights.periodSummary') %>">
                <div class="insights-metric insights-metric-total">
                    <dt><span class="metric-dot metric-dot-total" aria-hidden="true"></span><%= t('userInsights.totalTraffic') %></dt>
                    <dd id="trafficTotal">—</dd>
                </div>
                <div class="insights-metric">
                    <dt><span class="metric-dot metric-dot-tx" aria-hidden="true"></span><%= t('userInsights.uploaded') %></dt>
                    <dd id="trafficTx">—</dd>
                </div>
                <div class="insights-metric">
                    <dt><span class="metric-dot metric-dot-rx" aria-hidden="true"></span><%= t('userInsights.downloaded') %></dt>
                    <dd id="trafficRx">—</dd>
                </div>
            </dl>

            <div class="insights-state" id="trafficEmpty" hidden>
                <span class="insights-state-icon" aria-hidden="true"><i class="ti ti-chart-line"></i></span>
                <div>
                    <h3><%= t('userInsights.trafficEmptyTitle') %></h3>
                    <p><%= t('userInsights.trafficEmptyDescription') %></p>
                </div>
            </div>

            <div class="user-insights-visuals" id="trafficVisuals">
                <section class="insights-visual insights-chart-section" aria-labelledby="trafficChartTitle">
                    <div class="insights-visual-header">
                        <div>
                            <h3 id="trafficChartTitle"><%= t('userInsights.trendTitle') %></h3>
                            <p id="trafficGranularity"><%= t('userInsights.hourly') %></p>
                        </div>
                        <div class="traffic-legend" aria-label="<%= t('userInsights.chartLegend') %>">
                            <span><i class="legend-line legend-line-tx" aria-hidden="true"></i><%= t('userInsights.uploaded') %></span>
                            <span><i class="legend-line legend-line-rx" aria-hidden="true"></i><%= t('userInsights.downloaded') %></span>
                        </div>
                    </div>
                    <div class="traffic-chart" id="trafficChart"></div>
                    <div class="insights-inline-empty" id="trafficChartEmpty" hidden>
                        <i class="ti ti-chart-dots" aria-hidden="true"></i>
                        <span><%= t('userInsights.noTrendPoints') %></span>
                    </div>
                </section>

                <section class="insights-visual insights-nodes-section" aria-labelledby="trafficNodesTitle">
                    <div class="insights-visual-header">
                        <div>
                            <h3 id="trafficNodesTitle"><%= t('userInsights.nodeDistribution') %></h3>
                            <p><%= t('userInsights.nodeDistributionHint') %></p>
                        </div>
                    </div>
                    <div class="traffic-node-list" id="trafficNodes"></div>
                    <div class="insights-inline-empty" id="trafficNodesEmpty" hidden>
                        <i class="ti ti-server-off" aria-hidden="true"></i>
                        <span><%= t('userInsights.noNodeBreakdown') %></span>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <div class="user-insights-panel" id="userAccessPanel" role="tabpanel"
         aria-labelledby="userAccessTab" aria-busy="false" hidden>
        <div class="user-insights-toolbar">
            <div class="user-insights-context">
                <h3><%= t('userInsights.recentEvents') %></h3>
                <p><%= t('userInsights.accessSubtitle') %></p>
            </div>
            <a href="/panel/access-logs?email=<%= encodeURIComponent(user.userId) %>" class="btn btn-sm">
                <i class="ti ti-external-link" aria-hidden="true"></i> <%= t('userInsights.openAccessLogs') %>
            </a>
        </div>

        <div class="user-insights-skeleton" id="accessSkeleton" aria-hidden="true" hidden>
            <div class="insights-metrics insights-metrics-skeleton">
                <span class="ui-skeleton"></span><span class="ui-skeleton"></span><span class="ui-skeleton"></span>
            </div>
            <span class="ui-skeleton ui-skeleton-table"></span>
        </div>

        <div class="insights-state insights-state-warning" id="accessDisabled" hidden>
            <span class="insights-state-icon" aria-hidden="true"><i class="ti ti-list-search"></i></span>
            <div>
                <h3><%= t('userInsights.accessDisabledTitle') %></h3>
                <p><%= t('userInsights.accessDisabledDescription') %></p>
                <a href="/panel/settings?tab=accessLogs" class="btn btn-sm btn-primary">
                    <i class="ti ti-settings" aria-hidden="true"></i> <%= t('userInsights.enableInSettings') %>
                </a>
            </div>
        </div>

        <div class="insights-state insights-state-warning" id="accessDegraded" hidden>
            <span class="insights-state-icon" aria-hidden="true"><i class="ti ti-database-off"></i></span>
            <div>
                <h3><%= t('userInsights.accessDegradedTitle') %></h3>
                <p><%= t('userInsights.accessDegradedDescription') %></p>
                <a href="/panel/settings?tab=accessLogs" class="btn btn-sm btn-primary">
                    <i class="ti ti-database-cog" aria-hidden="true"></i> <%= t('userInsights.configureClickHouse') %>
                </a>
            </div>
        </div>

        <div class="insights-state insights-state-error" id="accessError" hidden>
            <span class="insights-state-icon" aria-hidden="true"><i class="ti ti-cloud-off"></i></span>
            <div>
                <h3><%= t('userInsights.accessErrorTitle') %></h3>
                <p><%= t('userInsights.accessErrorDescription') %></p>
                <button type="button" class="btn btn-sm" id="accessRetry">
                    <i class="ti ti-refresh" aria-hidden="true"></i> <%= t('userInsights.retry') %>
                </button>
            </div>
        </div>

        <div id="accessContent" hidden>
            <dl class="insights-metrics" aria-label="<%= t('userInsights.accessSummary') %>">
                <div class="insights-metric insights-metric-total">
                    <dt><span class="metric-dot metric-dot-total" aria-hidden="true"></span><%= t('userInsights.events') %></dt>
                    <dd id="accessEvents">—</dd>
                </div>
                <div class="insights-metric">
                    <dt><span class="metric-dot metric-dot-rx" aria-hidden="true"></span><%= t('userInsights.sourceIps') %></dt>
                    <dd id="accessIps">—</dd>
                </div>
                <div class="insights-metric">
                    <dt><span class="metric-dot metric-dot-tx" aria-hidden="true"></span><%= t('userInsights.destinations') %></dt>
                    <dd id="accessDestinations">—</dd>
