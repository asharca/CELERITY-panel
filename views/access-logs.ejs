<%
    const alJson = (value) => JSON.stringify(value)
        .replace(/</g, '\\u003c')
        .replace(/>/g, '\\u003e')
        .replace(/&/g, '\\u0026')
        .replace(/\u2028/g, '\\u2028')
        .replace(/\u2029/g, '\\u2029');
    const alNodeNames = (nodes || []).reduce((names, node) => {
        names[String(node._id)] = node.name;
        return names;
    }, {});
%>

<% if (!enabled) { %>
<section class="insights-state al-disabled-state" aria-labelledby="alDisabledTitle">
    <span class="insights-state-icon" aria-hidden="true"><i class="ti ti-list-search"></i></span>
    <div>
        <h2 id="alDisabledTitle"><%= t('accessLogs.disabledTitle') %></h2>
        <p><%= t('accessLogs.disabledBanner') %></p>
        <a href="/panel/settings?tab=accessLogs" class="btn btn-primary btn-sm">
            <i class="ti ti-settings" aria-hidden="true"></i>
            <%= t('accessLogs.openSettings') %>
        </a>
    </div>
</section>
<% } else { %>
<div id="accessLogsApp" class="access-logs-app" data-enabled="1" data-state="<%= state %>">
    <div id="alProgress" class="al-progress" aria-hidden="true"><span></span></div>
    <p id="alLive" class="ui-visually-hidden" role="status" aria-live="polite"></p>

    <div id="alDegraded" class="alert alert-info al-page-alert" role="status" hidden>
        <i class="ti ti-database-off" aria-hidden="true"></i>
        <span><%= t('accessLogs.chRequired') %></span>
        <a href="/panel/settings?tab=accessLogs"><%= t('accessLogs.openSettings') %></a>
    </div>

    <section class="al-filter-panel" aria-labelledby="alFilterTitle">
        <header class="al-filter-header">
            <div>
                <h2 id="alFilterTitle"><%= t('accessLogs.exploreTitle') %></h2>
                <p id="alRangeSummary"><%= t('accessLogs.defaultRangeHint') %></p>
            </div>
            <span id="alHealthBadge" class="al-health-badge al-health-loading">
                <i class="ti ti-loader-2 al-spin" aria-hidden="true"></i>
                <%= t('accessLogs.checkingPipeline') %>
            </span>
        </header>

        <form id="alFilters" novalidate>
            <div class="al-filter-toolbar">
                <fieldset class="al-range-fieldset">
                    <legend><%= t('accessLogs.quickRange') %></legend>
                    <div class="al-range-controls" role="group" aria-label="<%= t('accessLogs.quickRange') %>">
                        <button type="button" class="al-range-btn active" data-hours="24" aria-pressed="true">24h</button>
                        <button type="button" class="al-range-btn" data-hours="168" aria-pressed="false">7d</button>
                        <button type="button" class="al-range-btn" data-hours="720" aria-pressed="false">30d</button>
                    </div>
                </fieldset>

                <div class="form-group al-filter-search">
                    <label for="alQuery"><%= t('accessLogs.filterQuery') %></label>
                    <div class="al-search-input">
                        <i class="ti ti-search" aria-hidden="true"></i>
                        <input type="search" name="q" id="alQuery"
                               placeholder="<%= t('accessLogs.filterQueryPlaceholder') %>"
                               autocomplete="off" autocapitalize="none" spellcheck="false" enterkeyhint="search">
                    </div>
                </div>

                <div class="form-group">
                    <label for="alEmail"><%= t('accessLogs.filterUser') %></label>
                    <input type="text" name="email" id="alEmail"
                           placeholder="<%= t('accessLogs.filterUserPlaceholder') %>"
                           autocomplete="off" autocapitalize="none" spellcheck="false">
                </div>

                <div class="form-group">
                    <label for="alDest"><%= t('accessLogs.filterDestination') %></label>
                    <input type="text" name="destination" id="alDest"
                           placeholder="<%= t('accessLogs.filterDestinationPlaceholder') %>"
                           autocomplete="off" autocapitalize="none" spellcheck="false">
                </div>

                <div class="form-group">
                    <label for="alAction"><%= t('accessLogs.filterAction') %></label>
                    <select name="action" id="alAction">
                        <option value=""><%= t('accessLogs.allActions') %></option>
                        <option value="accepted"><%= t('accessLogs.actionAccepted') %></option>
                        <option value="rejected"><%= t('accessLogs.actionRejected') %></option>
                        <option value="blocked"><%= t('accessLogs.actionBlocked') %></option>
                    </select>
                </div>

                <div class="al-filter-actions">
                    <button type="submit" class="btn btn-primary" id="alSearchBtn">
                        <i class="ti ti-search" id="alSearchIcon" aria-hidden="true"></i>
                        <span><%= t('accessLogs.applyFilters') %></span>
                    </button>
                    <button type="button" class="btn" id="alReset">
                        <i class="ti ti-restore" aria-hidden="true"></i>
                        <%= t('common.reset') %>
                    </button>
                </div>
            </div>

            <details class="al-advanced-filters" id="alAdvancedFilters">
                <summary>
                    <span><i class="ti ti-adjustments-horizontal" aria-hidden="true"></i><%= t('accessLogs.moreFilters') %></span>
                    <span id="alAdvancedCount" class="al-filter-count" hidden></span>
                </summary>
                <div class="al-advanced-grid">
                    <div class="form-group">
                        <label for="alFrom"><%= t('accessLogs.filterFrom') %></label>
                        <input type="datetime-local" name="from" id="alFrom">
                    </div>
                    <div class="form-group">
                        <label for="alTo"><%= t('accessLogs.filterTo') %></label>
                        <input type="datetime-local" name="to" id="alTo">
                    </div>
                    <div class="form-group">
                        <label for="alNode"><%= t('accessLogs.filterNode') %></label>
                        <select name="nodeId" id="alNode">
                            <option value=""><%= t('accessLogs.allNodes') %></option>
                            <% (nodes || []).forEach(node => { %>
                                <option value="<%= node._id %>"><%= node.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="alSourceIp"><%= t('accessLogs.filterSource') %></label>
                        <input type="text" name="sourceIp" id="alSourceIp"
                               placeholder="<%= t('accessLogs.filterSourcePlaceholder') %>"
                               autocomplete="off" autocapitalize="none" spellcheck="false">
                    </div>
                    <div class="form-group">
                        <label for="alNetwork"><%= t('accessLogs.filterProtocol') %></label>
                        <select name="network" id="alNetwork">
                            <option value=""><%= t('accessLogs.allProtocols') %></option>
                            <option value="tcp">TCP</option>
                            <option value="udp">UDP</option>
                        </select>
                    </div>
                </div>
            </details>

            <p id="alFilterError" class="al-filter-error" role="alert" hidden></p>
            <div id="alActiveFilters" class="al-active-filters" aria-label="<%= t('accessLogs.activeFilters') %>" hidden></div>
        </form>
    </section>

    <dl class="al-summary" aria-label="<%= t('accessLogs.selectedSummary') %>">
        <div>
            <dt><span class="metric-dot metric-dot-total" aria-hidden="true"></span><%= t('accessLogs.statParsedEvents') %></dt>
            <dd id="alTotal">—</dd>
        </div>
        <div>
            <dt><i class="ti ti-users" aria-hidden="true"></i><%= t('accessLogs.statUsers') %></dt>
            <dd id="alUsers">—</dd>
        </div>
        <div>
            <dt><i class="ti ti-world" aria-hidden="true"></i><%= t('accessLogs.statUniqueSources') %></dt>
            <dd id="alIps">—</dd>
        </div>
        <div>
            <dt><i class="ti ti-map-pin" aria-hidden="true"></i><%= t('accessLogs.statUniqueDests') %></dt>
            <dd id="alDests">—</dd>
        </div>
        <div class="al-summary-risk">
            <dt><i class="ti ti-shield-x" aria-hidden="true"></i><%= t('accessLogs.statRejectedBlocked') %></dt>
            <dd id="alRisk">—</dd>
        </div>
    </dl>

    <section class="card al-events-card" aria-labelledby="alEventsTitle">
        <header class="card-header al-card-heading">
            <div>
                <h2 id="alEventsTitle"><i class="ti ti-list-details" aria-hidden="true"></i><%= t('accessLogs.recentEvents') %></h2>
                <p><%= t('accessLogs.recentEventsHint') %></p>
            </div>
            <span id="alResultCount" class="al-result-count" aria-live="polite"></span>
        </header>

        <div id="alSearchError" class="insights-state insights-state-error al-inline-state" role="alert" hidden>
            <span class="insights-state-icon" aria-hidden="true"><i class="ti ti-alert-circle"></i></span>
            <div>
                <h3><%= t('accessLogs.searchErrorTitle') %></h3>
                <p id="alSearchErrorText"><%= t('accessLogs.searchErrorDescription') %></p>
                <button type="button" class="btn btn-sm" id="alRetrySearch"><i class="ti ti-refresh" aria-hidden="true"></i><%= t('accessLogs.retry') %></button>
            </div>
        </div>

        <div id="alEventsTableWrap" class="al-table-scroll" tabindex="0" role="region" aria-label="<%= t('accessLogs.recentEvents') %>">
            <table class="al-table al-events-table">
                <caption class="ui-visually-hidden"><%= t('accessLogs.recentEventsCaption') %></caption>
                <thead>
                    <tr>
                        <th scope="col"><%= t('accessLogs.colTime') %></th>
                        <th scope="col"><%= t('accessLogs.filterNode') %></th>
                        <th scope="col"><%= t('accessLogs.colUser') %></th>
                        <th scope="col"><%= t('accessLogs.colSource') %></th>
                        <th scope="col"><%= t('accessLogs.colDest') %></th>
                        <th scope="col"><%= t('accessLogs.colNet') %></th>
                        <th scope="col"><%= t('accessLogs.colAction') %></th>
                    </tr>
                </thead>
                <tbody id="alResults"></tbody>
            </table>
        </div>

        <div id="alNoResults" class="insights-state al-inline-state" hidden>
            <span class="insights-state-icon" aria-hidden="true"><i class="ti ti-search-off"></i></span>
            <div>
                <h3><%= t('accessLogs.noResultsTitle') %></h3>
                <p><%= t('accessLogs.noResultsDescription') %></p>
            </div>
        </div>

        <footer class="al-events-footer">
            <button type="button" class="btn btn-sm" id="alLoadMore" hidden>
                <i class="ti ti-chevrons-down" aria-hidden="true"></i><%= t('accessLogs.loadMore') %>
            </button>
        </footer>
    </section>

    <details class="al-analysis-section" open>
        <summary class="al-section-heading">
            <div>
                <h2><i class="ti ti-chart-histogram" aria-hidden="true"></i><%= t('accessLogs.analysisTitle') %></h2>
                <p><%= t('accessLogs.analysisDescription') %></p>
            </div>
            <i class="ti ti-chevron-down al-section-chevron" aria-hidden="true"></i>
        </summary>

        <div class="al-analysis-body">
            <div id="alAnalyticsWarning" class="alert alert-warning al-page-alert" role="status" hidden>
                <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                <span><%= t('accessLogs.partialAnalyticsWarning') %></span>
            </div>

            <div id="alAnalyticsError" class="insights-state insights-state-error al-inline-state" role="alert" hidden>
                <span class="insights-state-icon" aria-hidden="true"><i class="ti ti-alert-circle"></i></span>
                <div>
                    <h3><%= t('accessLogs.analyticsErrorTitle') %></h3>
                    <p id="alAnalyticsErrorText"><%= t('accessLogs.analyticsErrorDescription') %></p>
                    <button type="button" class="btn btn-sm" id="alRetryAnalytics"><i class="ti ti-refresh" aria-hidden="true"></i><%= t('accessLogs.retry') %></button>
                </div>
            </div>

            <div id="alAnalyticsEmpty" class="insights-state al-inline-state" hidden>
                <span class="insights-state-icon" aria-hidden="true"><i class="ti ti-chart-bar-off"></i></span>
                <div>
                    <h3><%= t('accessLogs.analyticsEmptyTitle') %></h3>
                    <p><%= t('accessLogs.analyticsEmptyDescription') %></p>
                </div>
            </div>

            <div id="alAnalyticsContent">
                <div class="al-analytics-grid">
                    <section class="card al-timeline-card" aria-labelledby="alTimelineTitle">
                        <header class="card-header al-card-heading">
                            <div>
                                <h2 id="alTimelineTitle"><i class="ti ti-chart-bar" aria-hidden="true"></i><%= t('accessLogs.activityTimeline') %></h2>
                                <p id="alTimelineDescription"><%= t('accessLogs.timelineGapHint') %></p>
                            </div>
                        </header>
                        <div class="card-body al-chart-body">
                            <canvas id="alTimeline" role="img" aria-label="<%= t('accessLogs.activityTimeline') %>" aria-describedby="alTimelineDescription"></canvas>
                            <p id="alTimelineFallback" class="al-chart-fallback" hidden><%= t('accessLogs.chartUnavailable') %></p>
                        </div>
                    </section>

                    <section class="card al-breakdown-card" aria-labelledby="alBreakdownTitle">
                        <header class="card-header al-card-heading">
                            <div>
                                <h2 id="alBreakdownTitle"><i class="ti ti-chart-dots" aria-hidden="true"></i><%= t('accessLogs.breakdownTitle') %></h2>
                                <p><%= t('accessLogs.breakdownHint') %></p>
                            </div>
                        </header>
                        <div class="card-body al-breakdowns">
                            <div class="al-breakdown-block">
                                <h3><%= t('accessLogs.actionBreakdown') %></h3>
                                <div id="alActionBar" class="al-segmented-bar" role="img"></div>
                                <ul id="alActionLegend" class="al-breakdown-legend"></ul>
                            </div>
                            <div class="al-breakdown-block">
                                <h3><%= t('accessLogs.protocolBreakdown') %></h3>
                                <div id="alProtoBar" class="al-segmented-bar" role="img"></div>
                                <ul id="alProtoLegend" class="al-breakdown-legend"></ul>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="al-lens-grid">
                    <section class="card">
                        <header class="card-header al-card-heading">
                            <div>
                                <h2><i class="ti ti-user-share" aria-hidden="true"></i><%= t('accessLogs.usersBySource') %></h2>
                                <p><%= t('accessLogs.usersBySourceHint') %></p>
                            </div>
                        </header>
                        <div class="al-table-scroll" tabindex="0" role="region" aria-label="<%= t('accessLogs.usersBySource') %>">
                            <table class="al-table">
                                <caption class="ui-visually-hidden"><%= t('accessLogs.usersBySourceCaption') %></caption>
                                <thead><tr>
                                    <th scope="col"><%= t('accessLogs.colUser') %></th>
                                    <th scope="col" class="al-num"><%= t('accessLogs.colSources') %></th>
                                    <th scope="col" class="al-num"><%= t('accessLogs.colEvents') %></th>
                                    <th scope="col" class="al-num"><%= t('accessLogs.colLastSeen') %></th>
                                </tr></thead>
                                <tbody id="alUsersByIp"></tbody>
                            </table>
                        </div>
                    </section>

                    <section class="card">
                        <header class="card-header al-card-heading">
                            <div>
                                <h2><i class="ti ti-affiliate" aria-hidden="true"></i><%= t('accessLogs.usersByFanout') %></h2>
                                <p><%= t('accessLogs.usersByFanoutHint') %></p>
                            </div>
                        </header>
                        <div class="al-table-scroll" tabindex="0" role="region" aria-label="<%= t('accessLogs.usersByFanout') %>">
                            <table class="al-table">
                                <caption class="ui-visually-hidden"><%= t('accessLogs.usersByFanoutCaption') %></caption>
                                <thead><tr>
                                    <th scope="col"><%= t('accessLogs.colUser') %></th>
                                    <th scope="col" class="al-num"><%= t('accessLogs.colDests') %></th>
                                    <th scope="col" class="al-num"><%= t('accessLogs.colUdp') %></th>
                                    <th scope="col" class="al-num"><%= t('accessLogs.colEvents') %></th>
                                </tr></thead>
                                <tbody id="alUsersByFanout"></tbody>
                            </table>
                        </div>
                    </section>
                </div>

                <div class="al-top-grid">
                    <% [
                        { id: 'alTopDest', icon: 'ti-map-pin', title: 'topDestinations', label: 'colDest' },
                        { id: 'alTopPorts', icon: 'ti-plug', title: 'topPorts', label: 'colPort' },
                        { id: 'alTopBlocked', icon: 'ti-shield-x', title: 'topBlocked', label: 'colDest' }
                    ].forEach(item => { %>
                    <section class="card">
                        <header class="card-header"><h2><i class="ti <%= item.icon %>" aria-hidden="true"></i><%= t(`accessLogs.${item.title}`) %></h2></header>
                        <div class="al-table-scroll" tabindex="0" role="region" aria-label="<%= t(`accessLogs.${item.title}`) %>">
                            <table class="al-table al-top-table">
                                <caption class="ui-visually-hidden"><%= t(`accessLogs.${item.title}`) %></caption>
                                <thead><tr><th scope="col"><%= t(`accessLogs.${item.label}`) %></th><th scope="col" class="al-num"><%= t('accessLogs.colHits') %></th></tr></thead>
                                <tbody id="<%= item.id %>"></tbody>
                            </table>
                        </div>
                    </section>
                    <% }); %>
                </div>
            </div>
        </div>
    </details>

    <details class="card al-pipeline-panel">
        <summary class="card-header al-card-heading">
            <div>
                <h2><i class="ti ti-server-cog" aria-hidden="true"></i><%= t('accessLogs.pipelineTitle') %></h2>
                <p><%= t('accessLogs.pipelineDescription') %></p>
            </div>
            <span id="alSpoolSummary" class="al-pipeline-summary"><%= t('accessLogs.checkingPipeline') %></span>
        </summary>
        <div class="card-body">
            <div class="al-table-scroll" tabindex="0" role="region" aria-label="<%= t('accessLogs.pipelineTitle') %>">
                <table class="al-table">
                    <caption class="ui-visually-hidden"><%= t('accessLogs.pipelineCaption') %></caption>
                    <thead><tr>
                        <th scope="col"><%= t('accessLogs.filterNode') %></th>
                        <th scope="col"><%= t('accessLogs.agentVersion') %></th>
                        <th scope="col"><%= t('common.status') %></th>
                        <th scope="col"><%= t('accessLogs.lastIngestAt') %></th>
                        <th scope="col"><%= t('accessLogs.lastError') %></th>
                    </tr></thead>
                    <tbody id="alNodeStatus"></tbody>
                </table>
            </div>

            <div class="al-danger-zone">
                <div>
                    <strong><%= t('accessLogs.purge') %></strong>
                    <span><%= t('accessLogs.purgeHint') %></span>
                </div>
                <button type="button" class="btn btn-danger" id="alPurge">
                    <i class="ti ti-trash" aria-hidden="true"></i><%= t('accessLogs.purge') %>
                </button>
            </div>
        </div>
    </details>
</div>
<% } %>

<div id="toast" class="toast" role="status" aria-live="polite"></div>

<% if (enabled) { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
window.__AL_I18N = {
    locale: <%- alJson(typeof dateLocale !== 'undefined' ? dateLocale : lang) %>,
    loading: <%- alJson(t('accessLogs.loading')) %>,
    loaded: <%- alJson(t('accessLogs.loaded')) %>,
    purgeConfirm: <%- alJson(t('accessLogs.purgeConfirm')) %>,
    purgeSuccess: <%- alJson(t('accessLogs.purgeSuccess')) %>,
    noSources: <%- alJson(t('accessLogs.noSources')) %>,
    never: <%- alJson(t('settings.never')) %>,
    chRequired: <%- alJson(t('accessLogs.chRequired')) %>,
    searchErrorDescription: <%- alJson(t('accessLogs.searchErrorDescription')) %>,
    analyticsErrorDescription: <%- alJson(t('accessLogs.analyticsErrorDescription')) %>,
    partialAnalyticsWarning: <%- alJson(t('accessLogs.partialAnalyticsWarning')) %>,
    purgeError: <%- alJson(t('accessLogs.purgeError')) %>,
    sourceLoadError: <%- alJson(t('accessLogs.sourceLoadError')) %>,
    invalidRange: <%- alJson(t('accessLogs.invalidRange')) %>,
    showingEvents: <%- alJson(t('accessLogs.showingEvents')) %>,
    rangeUntilNow: <%- alJson(t('accessLogs.rangeUntilNow')) %>,
    rangeBetween: <%- alJson(t('accessLogs.rangeBetween')) %>,
    activeFilter: <%- alJson(t('accessLogs.activeFilter')) %>,
    removeFilter: <%- alJson(t('accessLogs.removeFilter')) %>,
    timelineAria: <%- alJson(t('accessLogs.timelineAria')) %>,
    timelineEmpty: <%- alJson(t('accessLogs.timelineEmpty')) %>,
    chartUnavailable: <%- alJson(t('accessLogs.chartUnavailable')) %>,
    userSourcesMeta: <%- alJson(t('accessLogs.userSourcesMeta')) %>,
    breakdownAria: <%- alJson(t('accessLogs.breakdownAria')) %>,
    pipelineSummary: <%- alJson(t('accessLogs.pipelineSummary')) %>,
    spoolSummary: <%- alJson(t('accessLogs.spoolSummary')) %>,
    unparsed: <%- alJson(t('accessLogs.unparsed')) %>,
    labels: {
        q: <%- alJson(t('accessLogs.filterQuery')) %>,
        email: <%- alJson(t('accessLogs.filterUser')) %>,
        destination: <%- alJson(t('accessLogs.filterDestination')) %>,
        action: <%- alJson(t('accessLogs.filterAction')) %>,
        nodeId: <%- alJson(t('accessLogs.filterNode')) %>,
        sourceIp: <%- alJson(t('accessLogs.filterSource')) %>,
        network: <%- alJson(t('accessLogs.filterProtocol')) %>,
        accepted: <%- alJson(t('accessLogs.actionAccepted')) %>,
        rejected: <%- alJson(t('accessLogs.actionRejected')) %>,
        blocked: <%- alJson(t('accessLogs.actionBlocked')) %>,
        tcp: 'TCP',
        udp: 'UDP',
        unknown: <%- alJson(t('common.unknown')) %>,
        time: <%- alJson(t('accessLogs.colTime')) %>,
        node: <%- alJson(t('accessLogs.filterNode')) %>,
        user: <%- alJson(t('accessLogs.colUser')) %>,
        source: <%- alJson(t('accessLogs.colSource')) %>,
        destinationLabel: <%- alJson(t('accessLogs.colDest')) %>,
        protocol: <%- alJson(t('accessLogs.colNet')) %>,
        actionLabel: <%- alJson(t('accessLogs.colAction')) %>
    },
    statuses: {
        disabled: <%- alJson(t('accessLogs.stateDisabled')) %>,
        pending: <%- alJson(t('accessLogs.nodeStatePending')) %>,
        active: <%- alJson(t('accessLogs.stateActive')) %>,
        degraded: <%- alJson(t('accessLogs.nodeStateDegraded')) %>,
        error: <%- alJson(t('accessLogs.stateError')) %>,
        'agent-outdated': <%- alJson(t('accessLogs.nodeStateAgentOutdated')) %>,
        'agent-missing': <%- alJson(t('accessLogs.nodeStateAgentMissing')) %>
    }
};
window.__AL_NODES = <%- alJson(alNodeNames) %>;
</script>
<script defer src="/js/access-logs.js"></script>
<% } %>
